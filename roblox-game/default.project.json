{
  "name": "SkyBakeryTycoon",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      },
      "$properties": {
        "CharacterUseJumpPower": true,
        "CharacterJumpPower": 50,
        "CharacterWalkSpeed": 16
      }
    },
    "Workspace": {
      "$properties": {
        "FallenPartsDestroyHeight": -300
      }
    },
    "Lighting": {
      "$properties": {
        "ClockTime": 14,
        "Brightness": 2.5,
        "Ambient": [
          0.55,
          0.5,
          0.6
        ],
        "OutdoorAmbient": [
          0.7,
          0.65,
          0.75
        ]
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": true
      }
    }
  }
}